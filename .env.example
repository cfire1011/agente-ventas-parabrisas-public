# Negocio
NEGOCIO_NOMBRE=Nombre del negocio
PRECIO=200

# Geocoding de direcciones (para que Safelite tome la dir bien)
# Ya funciona GRATIS sin key: Census USA + OpenStreetMap.
# Opcional — Google Maps Geocoding (mas preciso). Free tier ~$200/mes de credito:
#   1) https://console.cloud.google.com → proyecto nuevo
#   2) APIs & Services → Enable "Geocoding API"
#   3) Credentials → Create API key → restringir a Geocoding API
#   4) Pegar aca:
# GOOGLE_MAPS_API_KEY=AIza...

# Dashboard admin (http://localhost:8000/dashboard)
DASHBOARD_PASSWORD=

# --- Webhook fijo GRATIS (ngrok free) ---
# 1) Cuenta en https://dashboard.ngrok.com
# 2) Authtoken: ngrok config add-authtoken TU_TOKEN
# 3) Domains → copiá tu dominio free (ej. algo.ngrok-free.app)
# 4) Pegalo aca SIN https://
# NGROK_DOMAIN=algo.ngrok-free.app

